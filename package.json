{
  "name": "ironquill",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "check": "biome check --write .",
    "ci:check": "biome ci .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "lefthook": "^2.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "bcrypt",
      "esbuild",
      "lefthook"
    ]
  }
}
